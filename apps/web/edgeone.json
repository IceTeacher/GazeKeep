{
  "$schema": "https://cdnstatic.tencentcs.com/edgeone/pages/docs/edgeone.schema.json",
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/zh/", "statusCode": 302 }],
  "headers": [
    {
      "source": "/_astro/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/kmp-showcase/wasm/*.wasm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/kmp-showcase/js/*.wasm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/kmp-showcase/wasm/shared.*.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/kmp-showcase/js/shared.*.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/kmp-showcase/wasm/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/js/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/wasm/composeResources/gazekeep.shared.generated.resources/files/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/wasm/composeResources/gazekeep.shared.generated.resources/values/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/wasm/composeResources/gazekeep.shared.generated.resources/values-en/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/js/composeResources/gazekeep.shared.generated.resources/files/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/js/composeResources/gazekeep.shared.generated.resources/values/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/kmp-showcase/js/composeResources/gazekeep.shared.generated.resources/values-en/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ],
  "devCommand": "astro dev --host"
}
