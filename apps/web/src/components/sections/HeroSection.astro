---
import type { SiteContent } from "../../data/schema";
import { site } from "../../data/site.config";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Check from "@lucide/astro/icons/check";
import Download from "@lucide/astro/icons/download";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
---

<section id="hero" class="hero" data-route="home" data-status="idle">
  <canvas id="hero-shader" aria-hidden="true"></canvas>
  <div class="hero-orbit" aria-hidden="true"></div>
  <div class="hero-copy shell">
    <div class="product-note">
      <span class="tiny-dot"></span>
      {c.ui.productNote}
    </div>
    <h1>
      {c.hero.title.map((line) => (
        <span>{line}</span>
      ))}
    </h1>
    <p class="hero-description">{c.hero.subtitle}</p>
    <div class="hero-actions">
      <a class="button" href={site.download}>
        {c.download}
        <Download size={18} stroke-width={1.6} />
      </a>
      <a class="text-link" href={site.repository}>
        {c.source}
        <ArrowUpRight size={16} stroke-width={1.6} />
      </a>
    </div>
    <div class="trust-pills">
      {c.hero.pills.map((p) => (
        <span>
          <Check size={14} stroke-width={2} />
          {p}
        </span>
      ))}
    </div>
    <a class="explore" href="#workflow">
      <span class="scroll-mark"></span>
      {c.hero.explore}
    </a>
  </div>
  <div class="hero-device-slot" aria-hidden="true"></div>
</section>
