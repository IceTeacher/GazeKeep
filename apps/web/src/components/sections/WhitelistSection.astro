---
import type { SiteContent } from "../../data/schema";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
---

<section id="whitelist" class="whitelist shell feature-panel" data-route="whitelist" data-status="idle">
  <!-- 应用范围由左侧手机内的真实列表展示勾选与搜索，正文不再重复列出示例应用。 -->
  <div class="feature-copy">
    <div class="section-heading">
      <span class="section-kicker">{c.ui.kickers.whitelist}</span>
      <h2>{c.whitelist.title}</h2>
      <p>{c.whitelist.text}</p>
    </div>
  </div>
  <div class="device-slot" aria-hidden="true"></div>
</section>
