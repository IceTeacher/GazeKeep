---
import type { SiteContent } from "../../data/schema";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Ban from "@lucide/astro/icons/ban";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
---

<section id="whitelist" class="whitelist shell feature-panel" data-route="whitelist" data-status="idle">
  <!-- 应用范围由左侧手机内的真实列表展示勾选与搜索，正文不再重复列出示例应用。 -->
  <div class="feature-copy">
    <div class="section-heading">
      <span class="section-kicker">{c.ui.kickers.whitelist}</span>
      <h2>{c.whitelist.title}</h2>
      <p>{c.whitelist.text}</p>
    </div>
    <div class="whitelist-modes" role="group" aria-label={c.whitelist.scopeLabel}>
      {c.whitelist.modes.map((mode, i) => (
        <button type="button" class="scope-card" data-scope={mode.id} aria-pressed={i === 0 ? "true" : "false"}>
          <span class="scope-icon" aria-hidden="true">
            {mode.id === "whitelist" ? (
              <ShieldCheck size={18} stroke-width={1.8} />
            ) : (
              <Ban size={18} stroke-width={1.8} />
            )}
          </span>
          <span class="scope-copy">
            <strong>{mode.label}</strong>
            <span>{mode.summary}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
  <div class="device-slot" aria-hidden="true"></div>
</section>
