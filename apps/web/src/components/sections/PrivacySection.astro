---
import type { SiteContent } from "../../data/schema";
import { site } from "../../data/site.config";
import privacy from "../../data/privacy.generated.json";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import EyeOff from "@lucide/astro/icons/eye-off";
import MemoryStick from "@lucide/astro/icons/memory-stick";
import ScanFace from "@lucide/astro/icons/scan-face";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
// 依次对应隐私三句：按需短暂采样、画面仅在内存、看不清就熄屏。
const icons = [ScanFace, MemoryStick, EyeOff];
---

<section id="privacy" class="privacy-section">
  <div class="shell privacy-panel">
    <div class="section-heading privacy-heading" data-reveal>
      <span class="section-kicker">{c.ui.kickers.privacy}</span>
      <h2>{c.privacy.title}</h2>
      <p>{c.privacy.text}</p>
    </div>
    <div class="privacy-grid">
      <div class="privacy-lines" data-reveal>
        {privacy[c.locale].map((line, i) => {
          const Icon = icons[i]!;
          return (
            <article style={`--i: ${i}`}>
              <span class="privacy-icon" aria-hidden="true">
                <Icon size={22} stroke-width={1.6} />
              </span>
              <div>
                <h3>{c.privacy.labels[i]}</h3>
                <p>{line}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
    <details class="manifest-card" data-reveal>
      <summary>{c.privacy.permission}</summary>
      <pre><code>&lt;uses-permission android:name="android.permission.INTERNET" tools:node="remove" /&gt;</code></pre>
      <a class="text-link" href={`${site.repository}/blob/main/apps/app/android/src/main/AndroidManifest.xml`}>
        {c.source}
        <ArrowUpRight size={14} stroke-width={2} />
      </a>
    </details>
  </div>
</section>
