---
import type { SiteContent } from "../../data/schema";
import { getShowcaseHomePreview } from "../../data/showcase-preview";
import GripLayers from "./GripLayers.astro";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
const preview = getShowcaseHomePreview(c.locale);
---

<div id="device-track">
  <div id="phone-stage">
    <div class="phone-halo"></div>
    <div class="device-rig">
      <div id="phone-visual">
        <canvas id="phone-body" aria-hidden="true"></canvas>
        <div id="phone-chassis" data-effect="none">
          <div class="phone-screen">
            <div id="phone-placeholder">
              <div class="app-preview" aria-hidden="true">
                <div class="app-preview-body">
                  <div class="app-preview-topbar">
                    <div class="app-preview-title">{preview.title}</div>
                  </div>
                  <div class="app-preview-content">
                    <div class="app-preview-hero">
                      <div class="app-preview-hero-copy">
                        <div class="app-preview-state">{preview.working}</div>
                        <div class="app-preview-decision">{preview.lastDecision}</div>
                        <div class="app-preview-backend">{preview.backendName}</div>
                      </div>
                      <svg class="app-preview-ring" viewBox="0 0 92 92" fill="none">
                        <circle cx="46" cy="46" r="42" stroke="currentColor" stroke-width="8" />
                        <path
                          d="M26.68 47.84 41.4 61.64 66.24 33.12"
                          stroke="currentColor"
                          stroke-width="8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </div>
                    <div class="app-preview-card">
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.appVersionLabel}</div>
                        <div class="app-preview-value">{preview.appVersionValue}</div>
                      </div>
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.backendStatusLabel}</div>
                        <div class="app-preview-chips">
                          {preview.backends.map((backend) => (
                            <span class="app-preview-chip">
                              <span>{backend.name}</span>
                              <strong>{backend.status}</strong>
                            </span>
                          ))}
                        </div>
                      </div>
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.cameraSelfTestLabel}</div>
                        <div class="app-preview-chips">
                          <span class="app-preview-chip">
                            <span>{preview.cameraChip.label}</span>
                            <strong>{preview.cameraChip.value}</strong>
                          </span>
                          <span class="app-preview-chip">
                            <span>{preview.selfTestChip.label}</span>
                            <strong>{preview.selfTestChip.value}</strong>
                          </span>
                        </div>
                      </div>
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.androidVersionLabel}</div>
                        <div class="app-preview-value">—</div>
                      </div>
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.deviceModelLabel}</div>
                        <div class="app-preview-value">{preview.deviceModelValue}</div>
                      </div>
                      <div class="app-preview-item">
                        <div class="app-preview-label">{preview.fingerprintLabel}</div>
                        <div class="app-preview-value">—</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="app-preview-nav">
                  <div class="app-preview-tab is-active">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M10.7 2.8a2 2 0 0 1 2.6 0l7.5 6.3A2 2 0 0 1 21.5 10.6v8.2A2.2 2.2 0 0 1 19.3 21H15a1 1 0 0 1-1-1v-4.2a2 2 0 0 0-4 0V20a1 1 0 0 1-1 1H4.7a2.2 2.2 0 0 1-2.2-2.2v-8.2a2 2 0 0 1 .7-1.5l7.5-6.3Z" />
                    </svg>
                    <span>{preview.navHome}</span>
                  </div>
                  <div class="app-preview-tab">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.85"
                    >
                      <path d="M10.8 2.8a2.4 2.4 0 0 1 2.4 0l6 3.5a2.4 2.4 0 0 1 1.2 2.1v7.2a2.4 2.4 0 0 1-1.2 2.1l-6 3.5a2.4 2.4 0 0 1-2.4 0l-6-3.5a2.4 2.4 0 0 1-1.2-2.1V8.4a2.4 2.4 0 0 1 1.2-2.1l6-3.5Z" />
                      <circle cx="12" cy="12" r="3.2" />
                    </svg>
                    <span>{preview.navSettings}</span>
                  </div>
                </div>
              </div>
              <div class="placeholder-status">
                <img
                  src="/app-icon-192.webp"
                  class="placeholder-error-icon"
                  width="58"
                  height="58"
                  alt=""
                  loading="lazy"
                />
                <span id="load-message" role="status">
                  {c.loading}
                </span>
                <button tabindex="-1" aria-hidden="true" id="retry-showcase" class="button small" hidden>
                  {c.retry}
                </button>
              </div>
            </div>
            <div class="phone-viewport">
              <iframe id="kmp-frame" title={c.demo} tabindex="-1" inert loading="eager"></iframe>
            </div>
            <div id="screen-touch" aria-hidden="true"></div>
            <div class="screen-dim"></div>
            <div class="camera" aria-hidden="true">
              <span></span>
              <svg class="camera-halo" viewBox="0 0 28 28" aria-hidden="true">
                <circle cx="14" cy="14" r="12"></circle>
              </svg>
            </div>
            <div class="phone-statusbar" aria-hidden="true">
              <span>9:41</span>
              <span class="status-icons">
                <!-- 状态栏图标模仿 Android 原生实心风格，属于机身仿真而非界面图标，不使用 Lucide。 -->
                <svg
                  class="status-wifi"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M1 9a17 17 0 0 1 22 0L12 22Z"></path>
                </svg>
                <svg
                  class="status-signal"
                  width="15"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M2 22 22 2v20Z"></path>
                </svg>
                <svg
                  class="status-battery"
                  width="10"
                  height="17"
                  viewBox="0 0 14 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M5 1h4v2h3a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h3Z"
                    opacity=".35"
                  ></path>
                  <path d="M3 7h8v14H3Z"></path>
                </svg>
              </span>
            </div>
            <div class="home-indicator"></div>
          </div>
        </div>
        <GripLayers />
      </div>
    </div>
    <div class="live-status">
      <span class="tiny-dot"></span>
      <span id="demo-status">{c.status.idle}</span>
    </div>
  </div>
</div>
