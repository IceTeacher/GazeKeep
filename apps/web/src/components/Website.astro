---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./site/SiteHeader.astro";
import SiteFooter from "./site/SiteFooter.astro";
import HeroSection from "./sections/HeroSection.astro";
import PhoneStage from "./device/PhoneStage.astro";
import WorkflowSection from "./sections/WorkflowSection.astro";
import BackendsSection from "./sections/BackendsSection.astro";
import WhitelistSection from "./sections/WhitelistSection.astro";
import PrivacySection from "./sections/PrivacySection.astro";
import StartSection from "./sections/StartSection.astro";
import FaqSection from "./sections/FaqSection.astro";
import ClosingSection from "./sections/ClosingSection.astro";
import type { SiteContent } from "../data/schema";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
---

<BaseLayout content={c}>
  <a class="skip-link" href="#main">
    {c.ui.skip}
  </a>
  <SiteHeader content={c} />
  <button id="retry-hit" aria-label={c.retry} hidden></button>
  <main id="main">
    <!-- 首屏至专注范围共用同一部 sticky 手机，三者必须同处一个滚动叙事容器。 -->
    <div id="showcase-story">
      <HeroSection content={c} />
      <PhoneStage content={c} />
      <WorkflowSection content={c} />
      <BackendsSection content={c} />
      <WhitelistSection content={c} />
    </div>
    <div class="free-flow">
      <PrivacySection content={c} />
      <StartSection content={c} />
      <FaqSection content={c} />
      <ClosingSection content={c} />
    </div>
  </main>
  <SiteFooter content={c} />
  <script
    type="application/json"
    id="showcase-content"
    set:html={JSON.stringify({ status: c.status, hint: c.hint, loading: c.loading, locale: c.locale }).replace(
      /</g,
      "\\u003c",
    )}
  />
  <script>
    import { initWebsite } from "../scripts/orchestrator";
    initWebsite();
  </script>
</BaseLayout>
