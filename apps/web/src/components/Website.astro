---
import GripLayers from "./GripLayers.astro";
import type { SiteContent } from "../data/schema";
import { site } from "../data/site.config";
import privacy from "../data/privacy.generated.json";
import "../styles/global.css";
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
const sections = ["workflow", "backends", "privacy", "faq"];
---

<!doctype html>
<html lang={c.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/app-icon.png" />
    <meta property="og:locale" content={c.locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#080d18" />
    <link rel="icon" href="/app-icon.png" />
    <link rel="alternate" hreflang="zh" href="/zh/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/zh/" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("gazekeep-theme");
        document.documentElement.dataset.theme =
          saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      } catch {
        document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {c.locale === "zh" ? "跳至正文" : "Skip to content"}
    </a>
    <header class="nav-wrap">
      <nav class="nav shell" aria-label={c.menu}>
        <a class="brand" href={`/${c.locale}/`}>
          <img src="/app-icon.png" width="32" height="32" alt="" />
          <span>GazeKeep</span>
        </a>
        <div class="nav-links">
          {c.nav.map((name, i) => (
            <a href={`#${sections[i]}`}>{name}</a>
          ))}
        </div>
        <div class="nav-actions">
          <a
            class="language"
            href={c.locale === "zh" ? "/en/" : "/zh/"}
            lang={c.locale === "zh" ? "en" : "zh"}
            aria-label={c.locale === "zh" ? "Switch to English" : "切换至中文"}
          >
            {c.locale === "zh" ? "EN" : "中文"}
          </a>
          <button id="theme-toggle" class="icon-button" aria-label={c.theme}>
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
          </button>
          <a class="button small" href={site.download}>
            {c.download}
            <span aria-hidden="true">↗</span>
          </a>
          <button
            id="menu-toggle"
            class="icon-button"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={c.menu}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" class="mobile-menu shell">
        {c.nav.map((name, i) => (
          <a href={`#${sections[i]}`}>{name}</a>
        ))}
        <a href={site.download}>{c.download} ↗</a>
      </div>
    </header>
    <button id="retry-hit" aria-label={c.retry} hidden></button>
    <main id="main">
      <div id="showcase-story">
        <section id="hero" class="hero" data-route="home" data-status="idle">
          <canvas id="hero-shader" aria-hidden="true"></canvas>
          <div class="hero-orbit" aria-hidden="true"></div>
          <div class="hero-copy shell">
            <div class="product-note">
              <span class="tiny-dot"></span>
              {c.locale === "zh" ? "为 Android 而生的注视默契" : "A little understanding. For Android."}
            </div>
            <h1>
              {c.hero.title.map((line) => (
                <span>{line}</span>
              ))}
            </h1>
            <p class="hero-description">{c.hero.subtitle}</p>
            <div class="hero-actions">
              <a class="button" href={site.download}>
                {c.download}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" />
                </svg>
              </a>
              <a class="text-link" href={site.repository}>
                {c.source}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="trust-pills">
              {c.hero.pills.map((p) => (
                <span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                    <path d="m3 8 3 3 7-7" />
                  </svg>
                  {p}
                </span>
              ))}
            </div>
            <a class="explore" href="#workflow">
              <span class="scroll-mark"></span>
              {c.hero.explore}
            </a>
          </div>
          <div class="hero-device-slot" aria-hidden="true"></div>
        </section>
        <div id="device-track">
          <div id="phone-stage">
            <div class="phone-halo"></div>
            <div class="device-rig">
              <div id="phone-visual">
                <canvas id="phone-body" aria-hidden="true"></canvas>
                <div id="phone-chassis" data-effect="none">
                  <div class="phone-screen">
                    <div id="phone-placeholder">
                      <img src="/app-icon.png" width="58" height="58" alt="" />
                      <span id="load-message" role="status">
                        {c.loading}
                      </span>
                      <span class="loader"></span>
                      <button tabindex="-1" aria-hidden="true" id="retry-showcase" class="button small" hidden>
                        {c.retry}
                      </button>
                    </div>
                    <div class="phone-viewport">
                      <iframe id="kmp-frame" title={c.demo} tabindex="-1" inert loading="eager"></iframe>
                    </div>
                    <div class="screen-dim"></div>
                    <div class="camera" aria-hidden="true">
                      <span></span>
                      <svg class="camera-halo" viewBox="0 0 28 28" aria-hidden="true">
                        <circle cx="14" cy="14" r="12" />
                      </svg>
                    </div>
                    <div class="phone-statusbar" aria-hidden="true">
                      <span>9:41</span>
                      <span class="status-icons">
                        <svg
                          class="status-wifi"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M1 9a17 17 0 0 1 22 0L12 22Z" />
                        </svg>
                        <svg
                          class="status-signal"
                          width="15"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M2 22 22 2v20Z" />
                        </svg>
                        <svg
                          class="status-battery"
                          width="10"
                          height="17"
                          viewBox="0 0 14 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path
                            d="M5 1h4v2h3a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h3Z"
                            opacity=".35"
                          />
                          <path d="M3 7h8v14H3Z" />
                        </svg>
                      </span>
                    </div>
                    <div class="home-indicator"></div>
                  </div>
                </div>
                <GripLayers />
              </div>
            </div>
            <div class="live-status">
              <span class="tiny-dot"></span>
              <span id="demo-status">{c.status.idle}</span>
            </div>
          </div>
        </div>
        <section id="workflow" class="workflow shell">
          <div class="section-heading story-heading">
            <span class="section-kicker">{c.locale === "zh" ? "恰到好处的工作方式" : "Considered by design"}</span>
            <h2>{c.story.title}</h2>
            <p>{c.story.intro}</p>
          </div>
          <div class="story-steps">
            <div class="story-sticky">
              {c.story.steps.map((step, i) => (
                <article class="story-step" data-route={step.route} data-status={step.state} data-effect={step.effect}>
                  <span class="step-index">0{i + 1}</span>
                  <div class="story-copy">
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                    <div class="step-line"></div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
        <section id="backends" class="backends shell feature-panel" data-route="backend" data-status="backend_lsposed">
          <div class="section-heading">
            <span class="section-kicker">{c.locale === "zh" ? "三种连接，一份默契" : "Three ways to connect"}</span>
            <h2>{c.backends.title}</h2>
            <p>{c.backends.intro}</p>
          </div>
          <div class="backend-list">
            {c.backends.items.map((item, i) => (
              <button class="backend-card" data-backend={item.id} aria-pressed={i === 0 ? "true" : "false"}>
                <div class="backend-top">
                  <span class="backend-symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path
                        d={
                          i === 0
                            ? "m12 4 8 4-8 4-8-4zM4 12l8 4 8-4M4 16l8 4 8-4"
                            : i === 1
                              ? "M4 5h16v14H4zM8 10l3 2-3 2m5 1h3"
                              : "M10.5 6.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0M6 9.5l6 1.5 6-1.5M12 11v4l-3 5m3-5 3 5"
                        }
                      />
                    </svg>
                  </span>
                  <span class="backend-tag">{item.tag}</span>
                </div>
                <h3>{item.name}</h3>
                <p>{item.text}</p>
                <span class="requirement">{item.requirement}</span>
              </button>
            ))}
          </div>
          <div class="device-slot" aria-hidden="true"></div>
        </section>
        <section id="whitelist" class="whitelist shell feature-panel" data-route="whitelist" data-status="idle">
          <div class="section-heading">
            <span class="section-kicker">{c.locale === "zh" ? "你的范围，你的节奏" : "Your focus, your rules"}</span>
            <h2>{c.whitelist.title}</h2>
            <p>{c.whitelist.text}</p>
          </div>
          <div class="focus-list" aria-label={c.locale === "zh" ? "示例应用范围" : "Example app selection"}>
            {c.whitelist.categories.slice(0, 3).map((name, i) => (
              <div class="focus-row">
                <span class="focus-app" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5">
                    {i === 1 ? (
                      <>
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3q-8 9 0 18M12 3q8 9 0 18" />
                      </>
                    ) : (
                      <>
                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <path d="M9 8h6m-6 4h6m-6 4h4" />
                      </>
                    )}
                  </svg>
                </span>
                <span>{name}</span>
                <span class:list={["focus-selection", { selected: i < 2 }]}>
                  {i < 2 ? (c.locale === "zh" ? "已选中" : "Selected") : c.locale === "zh" ? "未选中" : "Not selected"}
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="10" cy="10" r="8" />
                    {i < 2 && <path d="m6 10 3 3 5-6" />}
                  </svg>
                </span>
              </div>
            ))}
          </div>
          <button class="limit-card" id="show-limit">
            <span>{c.locale === "zh" ? "保护上限" : "Protection limit"}</span>
            <strong>{c.whitelist.limit}</strong>
            <span>{c.whitelist.detail}</span>
            <span class="limit-link">{c.locale === "zh" ? "查看设置 ↗" : "View settings ↗"}</span>
          </button>
          <div class="device-slot" aria-hidden="true"></div>
        </section>
      </div>
      <section id="privacy" class="privacy-section">
        <div class="privacy-aura" aria-hidden="true"></div>
        <div class="shell privacy-panel">
          <div class="section-heading privacy-heading">
            <span class="section-kicker">
              {c.locale === "zh" ? "隐私，始于克制。" : "Privacy starts with restraint."}
            </span>
            <h2>{c.privacy.title}</h2>
            <p>{c.privacy.text}</p>
          </div>
          <div class="privacy-grid">
            <div class="privacy-lines">
              {privacy[c.locale].map((line, i) => (
                <article>
                  <span class="privacy-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="24"
                      height="24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                    >
                      <path
                        d={
                          i === 0
                            ? "M12 3v3m0 12v3M3 12h3m12 0h3M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0"
                            : i === 1
                              ? "M6 5h12v14H6zM9 9h6m-6 3h6m-6 3h3"
                              : "M12 3l8 4v5c0 5-8 9-8 9S4 17 4 12V7zM8 12l3 3 5-6"
                        }
                      />
                    </svg>
                  </span>
                  <div>
                    <h3>{c.privacy.labels[i]}</h3>
                    <p>{line}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <details class="manifest-card">
            <summary>{c.privacy.permission}</summary>
            <pre><code>&lt;uses-permission android:name="android.permission.INTERNET" tools:node="remove" /&gt;</code></pre>
            <a class="text-link" href={`${site.repository}/blob/main/apps/app/android/src/main/AndroidManifest.xml`}>
              {c.source} ↗
            </a>
          </details>
        </div>
      </section>
      <section id="start" class="start-section shell">
        <div class="section-heading">
          <h2>{c.start.title}</h2>
        </div>
        <div class="start-grid">
          {c.start.steps.map((step, i) => (
            <article>
              <span class="start-number">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </section>
      <section id="faq" class="faq-section shell">
        <h2>{c.faq.title}</h2>
        <div class="faq-list">
          {c.faq.items.map((item, i) => (
            <div class="faq-item">
              <h3>
                <button aria-expanded="false" aria-controls={`answer-${i}`} class="faq-trigger">
                  {item.question}
                  <span aria-hidden="true">+</span>
                </button>
              </h3>
              <div id={`answer-${i}`} class="faq-answer" inert>
                <div>
                  <p>{item.answer}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
      <section class="closing shell">
        <div class="closing-glow" aria-hidden="true"></div>
        <img src="/app-icon.png" width="64" height="64" alt="" />
        <h2>{c.footer.title}</h2>
        <p>{c.footer.text}</p>
        <a class="button" href={site.download}>
          {c.download}
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>
    <footer class="footer shell">
      <a class="brand" href={`/${c.locale}/`}>
        GazeKeep
      </a>
      <span>{c.locale === "zh" ? "目光所及，屏幕常明。" : "Stay in the moment."}</span>
      <div>
        <a href={site.repository}>GitHub</a>
        <a href={site.docs}>{c.footer.docs}</a>
        <a href={site.license}>{c.footer.license}</a>
        <a href={c.locale === "zh" ? "/en/" : "/zh/"}>{c.locale === "zh" ? "English" : "中文"}</a>
      </div>
    </footer>
    <script
      type="application/json"
      id="showcase-content"
      set:html={JSON.stringify({ status: c.status, loading: c.loading, locale: c.locale }).replace(/</g, "\\u003c")}
    />
    <script>
      import { initWebsite } from "../scripts/orchestrator";
      initWebsite();
    </script>
  </body>
</html>
