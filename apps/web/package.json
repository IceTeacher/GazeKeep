{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/sync-kmp-strings.ts && astro dev --host",
    "build": "node scripts/build.ts",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=gazekeep --branch=main",
    "preview": "astro preview --host 127.0.0.1",
    "astro": "astro",
    "build:site": "node scripts/sync-kmp-strings.ts && astro build",
    "check": "node scripts/sync-kmp-strings.ts && astro check",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "font:showcase": "node scripts/subset-showcase-font.ts",
    "test": "node scripts/sync-kmp-strings.ts && vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "node scripts/sync-kmp-strings.ts && vitest run --project browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.0",
    "gsap": "^3.14.0",
    "shaders": "4.0.4",
    "tailwindcss": "^4.0.0",
    "three": "^0.186.1"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "harfbuzzjs": "1.6.3",
    "playwright": "1.64.1",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wrangler": "^4.151.2"
  }
}
