{
  "name": "gazekeep-dev-tools",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tools:setup": "python3 scripts/setup_dev_tools.py",
    "hooks:install": "python3 scripts/install_hooks.py",
    "verify:hooks": "python3 scripts/check_hooks.py",
    "verify:docs": "python3 scripts/check_docs.py",
    "verify:agent-assets": "python3 scripts/check_agent_assets.py",
    "verify:architecture": "python3 scripts/check_architecture.py",
    "test:tools": "python3 -m unittest discover -s scripts/tests -v",
    "format:check": "python3 scripts/hook_files.py all --check",
    "format": "python3 scripts/hook_files.py all",
    "verify:commits": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@prettier/plugin-xml": "3.4.2",
    "lefthook": "2.1.17",
    "prettier": "3.9.9"
  }
}
